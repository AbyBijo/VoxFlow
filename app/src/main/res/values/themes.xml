<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No splash theme, no splash Activity: the app opens straight onto
         Home. windowBackground matches Home so there is no flash. -->
    <style name="Theme.VoxFlow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
